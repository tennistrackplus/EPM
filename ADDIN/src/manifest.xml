                        <Title resid="PreferenciasItemLabel"/>
                        <Description resid="PreferenciasItemTooltip"/>
                      </Supertip>

                      <Icon>
                        <bt:Image size="16" resid="ItemPreferencias16"/>
                        <bt:Image size="32" resid="ItemPreferencias32"/>
                        <bt:Image size="80" resid="ItemPreferencias80"/>
                      </Icon>

                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>comingSoon</FunctionName>
                      </Action>

                    </Item>


                    <!-- DIAGNÓSTICO -->

                    <Item id="DiagnosticoItem">

                      <Label resid="DiagnosticoItemLabel"/>

                      <Supertip>
                        <Title resid="DiagnosticoItemLabel"/>
                        <Description resid="DiagnosticoItemTooltip"/>
                      </Supertip>

                      <Icon>
                        <bt:Image size="16" resid="ItemDiagnostico16"/>
                        <bt:Image size="32" resid="ItemDiagnostico32"/>
                        <bt:Image size="80" resid="ItemDiagnostico80"/>
                      </Icon>

                      <Action xsi:type="ExecuteFunction">
