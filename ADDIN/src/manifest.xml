                  <bt:Image size="80" resid="ConexionGroup80"/>
                </Icon>

                <Control xsi:type="Button" id="ConexionButton">

                  <Label resid="ConexionButtonLabel"/>

                  <Supertip>
                    <Title resid="ConexionButtonLabel"/>
                    <Description resid="ConexionButtonTooltip"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="Conexion16"/>
                    <bt:Image size="32" resid="Conexion32"/>
                    <bt:Image size="80" resid="Conexion80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ConexionPane</TaskpaneId>
                    <SourceLocation resid="LoginUrl"/>
                  </Action>

                </Control>
              </Group>


              <!-- ===================================================== -->
              <!-- GRUPO: MODELO SEMÁNTICO -->
              <!-- ===================================================== -->

              <Group id="ModeloGroup">
