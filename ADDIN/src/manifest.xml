                    <bt:Image size="80" resid="ModeloGuardar80"/>
                  </Icon>

                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>guardarModeloSemantico</FunctionName>
                  </Action>

                </Control>

              </Group>


