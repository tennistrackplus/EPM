                    <bt:Image size="32" resid="InformeEliminar32"/>
                    <bt:Image size="80" resid="InformeEliminar80"/>
                  </Icon>

                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>comingSoon</FunctionName>
                  </Action>

                </Control>

              </Group>


