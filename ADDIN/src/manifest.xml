                      </Action>

                    </Item>


                    <!-- ACERCA DE -->

                    <Item id="AcercaDeItem">

                      <Label resid="AcercaDeItemLabel"/>

                      <Supertip>
                        <Title resid="AcercaDeItemLabel"/>
                        <Description resid="AcercaDeItemTooltip"/>
                      </Supertip>

                      <Icon>
                        <bt:Image size="16" resid="ItemAcercaDe16"/>
                        <bt:Image size="32" resid="ItemAcercaDe32"/>
                        <bt:Image size="80" resid="ItemAcercaDe80"/>
                      </Icon>

                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>comingSoon</FunctionName>
                      </Action>

                    </Item>

                  </Items>

                </Control>

              </Group>

              <Label resid="TabLabel"/>

            </CustomTab>

          </ExtensionPoint>


          <!-- ===================================================== -->
          <!-- MENÚ CONTEXTUAL (clic derecho sobre una celda) -->
          <!-- ===================================================== -->

          <ExtensionPoint xsi:type="ContextMenu">

            <OfficeMenu id="ContextMenuCell">

              <Control xsi:type="Menu" id="DracoContextMenuGroup">

                <Label resid="TabLabel"/>

                <Supertip>
                  <Title resid="TabLabel"/>
                  <Description resid="DistribuirValoresButtonTooltip"/>
                </Supertip>

                <Icon>
                  <bt:Image size="16" resid="DistribuirValores16"/>
                  <bt:Image size="32" resid="DistribuirValores32"/>
                  <bt:Image size="80" resid="DistribuirValores80"/>
                </Icon>

                <Items>

                  <Item id="DistribuirValoresContextItem">

                    <Label resid="DistribuirValoresButtonLabel"/>

                    <Supertip>
                      <Title resid="DistribuirValoresButtonLabel"/>
                      <Description resid="DistribuirValoresButtonTooltip"/>
                    </Supertip>

                    <Icon>
                      <bt:Image size="16" resid="DistribuirValores16"/>
                      <bt:Image size="32" resid="DistribuirValores32"/>
                      <bt:Image size="80" resid="DistribuirValores80"/>
                    </Icon>

                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>abrirDistribuirValores</FunctionName>
                    </Action>

                  </Item>

                </Items>

              </Control>

            </OfficeMenu>

          </ExtensionPoint>

        </DesktopFormFactor>

      </Host>
