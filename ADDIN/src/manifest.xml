                <Icon>
                  <bt:Image size="16" resid="ModeloGroup16"/>
                  <bt:Image size="32" resid="ModeloGroup32"/>
                  <bt:Image size="80" resid="ModeloGroup80"/>
                </Icon>


                <!-- CREAR -->

                <Control xsi:type="Button" id="ModeloCrearButton">

                  <Label resid="ModeloCrearButtonLabel"/>

                  <Supertip>
                    <Title resid="ModeloCrearButtonLabel"/>
                    <Description resid="ModeloButtonTooltip"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="ModeloCrear16"/>
                    <bt:Image size="32" resid="ModeloCrear32"/>
                    <bt:Image size="80" resid="ModeloCrear80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ModeloPane</TaskpaneId>
                    <SourceLocation resid="ModeloUrl"/>
                  </Action>

                </Control>


                <!-- ABRIR: abre directamente el diálogo independiente de
                     importación LookML (Office Dialog API), sin depender
                     de que el taskpane del modelo semántico esté abierto. -->

                <Control xsi:type="Button" id="ModeloAbrirButton">

                  <Label resid="ModeloAbrirButtonLabel"/>

                  <Supertip>
                    <Title resid="ModeloAbrirButtonLabel"/>
                    <Description resid="ModeloAbrirButtonTooltip"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="ModeloAbrir16"/>
                    <bt:Image size="32" resid="ModeloAbrir32"/>
                    <bt:Image size="80" resid="ModeloAbrir80"/>
                  </Icon>

                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>abrirModeloSemantico</FunctionName>
                  </Action>

                </Control>


                <!-- GUARDAR: abre directamente el diálogo independiente de
                     exportación a LookML (Office Dialog API), sin depender
                     de que el taskpane del modelo semántico esté abierto. -->

                <Control xsi:type="Button" id="ModeloGuardarButton">

                  <Label resid="ModeloGuardarButtonLabel"/>

                  <Supertip>
                    <Title resid="ModeloGuardarButtonLabel"/>
