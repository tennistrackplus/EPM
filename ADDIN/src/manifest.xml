        <bt:Set Name="ContextMenuApi" MinVersion="1.1"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="Workbook">

        <DesktopFormFactor>

          <FunctionFile resid="CommandsUrl"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">

            <CustomTab id="DracoTab">

              <!-- ===================================================== -->
              <!-- GRUPO: CONEXIÓN -->
              <!-- ===================================================== -->

              <Group id="ConexionGroup">
                <Label resid="ConexionGroupLabel"/>

                <Icon>
                  <bt:Image size="16" resid="ConexionGroup16"/>
